{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "timeout": 10,
            "statusMessage": "impulse-brake 检查冲动信号"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell|local_shell|exec|exec_command|terminal|run",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pre-tool-use.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
